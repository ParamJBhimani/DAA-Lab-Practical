
#include <iostream>
#include <algorithm>
#include <climits>
using namespace std;

int n;
int dist[15][15];
int dp[15][1 << 15];

int tsp(int city, int visited)
{
    // All cities visited
    if (visited == (1 << n) - 1)
        return dist[city][0];

    // Return stored result
    if (dp[city][visited] != -1)
        return dp[city][visited];

    int ans = INT_MAX;

    // Visit unvisited cities
    for (int i = 0; i < n; i++)
    {
        if (!(visited & (1 << i)))
        {
            int cost = dist[city][i] +
                       tsp(i, visited | (1 << i));

            ans = min(ans, cost);
        }
    }

    return dp[city][visited] = ans;
}

int main()
{
    cout << "Enter number of cities: ";
    cin >> n;

    if (n < 2 || n > 15)
    {
        cout << "Enter cities between 2 and 15.";
        return 0;
    }

    cout << "Enter the distance matrix:\n";

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
        {
            cin >> dist[i][j];
        }
    }

    fill(&dp[0][0], &dp[0][0] + 15 * (1 << 15), -1);

    int result = tsp(0, 1);

    cout << "\nMinimum travelling cost: "
         << result << endl;

    return 0;
}
